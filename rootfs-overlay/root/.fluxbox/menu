[begin] (PhantomOS Lab)
  [submenu] (  Applications  )
    [exec] (  File Manager  ) {pcmanfm}
    [exec] (  Text Editor (Leafpad)  ) {leafpad}
    [exec] (  Terminal  ) {xterm -bg "#181825" -fg "#cdd6f4" -cr "#89b4fa" -bd "#313244"}
  [end]
  [submenu] (  Backend Lab  )
    [exec] (  Backend Test Suite  ) {xterm -bg "#181825" -fg "#cdd6f4" -title "Backend Lab" -e /opt/tui-menu/menu.sh}
    [exec] (  System Monitor (htop)  ) {xterm -bg "#181825" -fg "#cdd6f4" -title "System Monitor" -e htop}
  [end]
  [separator]
  [submenu] (  Settings & Themes  )
    [stylesdir] (/usr/share/fluxbox/styles)
    [exec] (  Desktop Settings  ) {pcmanfm --desktop-pref}
  [end]
  [workspaces] (  Workspaces  )
  [separator]
  [reconfig] (  Reload Desktop  )
  [restart] (  Restart Fluxbox  )
  [separator]
  [exec] (  Reboot  ) {reboot}
  [exec] (  Power Off  ) {poweroff}
[end]
