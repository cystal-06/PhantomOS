gtk-theme-name = "PhantomDark"
gtk-icon-theme-name = "PhantomGNOME"
gtk-font-name = "Adwaita Sans 10"
gtk-cursor-theme-name = "Adwaita"
gtk-toolbar-style = GTK_TOOLBAR_ICONS
gtk-toolbar-icon-size = GTK_ICON_SIZE_SMALL_TOOLBAR
gtk-button-images = 0
gtk-menu-images = 1
gtk-enable-event-sounds = 0
gtk-enable-input-feedback-sounds = 0
gtk-double-click-time = 500
gtk-double-click-distance = 14
gtk-xft-antialias = 1
gtk-xft-hinting = 1
gtk-xft-hintstyle = "hintslight"
gtk-xft-rgba = "rgb"

gtk-color-scheme = "base_color:#151826\nbg_color:#1b1e2e\ntooltip_bg_color:#121420\nselected_bg_color:#3b6cc4\ntext_color:#e2e8f0\nfg_color:#e2e8f0\ntooltip_fg_color:#e2e8f0\nselected_fg_color:#ffffff"

style "adwaita-flat" {
  xthickness = 5
  ythickness = 4

  GtkWidget::focus-line-width = 1
  GtkButton::default-border = { 0, 0, 0, 0 }
  GtkButton::inner-border = { 10, 10, 5, 5 }
  GtkRange::trough-border = 0
  GtkRange::slider-width = 6
  GtkRange::stepper-size = 0
  GtkScrollbar::has-backward-stepper = 0
  GtkScrollbar::has-forward-stepper = 0
  GtkScrollbar::min-slider-length = 36
  GtkScrolledWindow::scrollbar-spacing = 2
  GtkPaned::handle-size = 4
  GtkMenuBar::shadow-type = GTK_SHADOW_NONE
  GtkToolbar::shadow-type = GTK_SHADOW_NONE
  GtkStatusbar::shadow-type = GTK_SHADOW_NONE
  GtkMenu::horizontal-padding = 4
  GtkMenu::vertical-padding = 6
  GtkMenuItem::horizontal-padding = 10

  bg[NORMAL]        = "#1b1e2e"
  bg[PRELIGHT]      = "#292f47"
  bg[ACTIVE]        = "#141724"
  bg[SELECTED]      = "#3b6cc4"
  bg[INSENSITIVE]   = "#161826"

  fg[NORMAL]        = "#e2e8f0"
  fg[PRELIGHT]      = "#ffffff"
  fg[ACTIVE]        = "#e2e8f0"
  fg[SELECTED]      = "#ffffff"
  fg[INSENSITIVE]   = "#64748b"

  base[NORMAL]      = "#151826"
  base[PRELIGHT]    = "#292f47"
  base[ACTIVE]      = "#22273c"
  base[SELECTED]    = "#3b6cc4"
  base[INSENSITIVE] = "#151826"

  text[NORMAL]      = "#e2e8f0"
  text[PRELIGHT]    = "#ffffff"
  text[ACTIVE]      = "#e2e8f0"
  text[SELECTED]    = "#ffffff"
  text[INSENSITIVE] = "#64748b"
}
class "GtkWidget" style "adwaita-flat"

style "adwaita-menu" {
  xthickness = 6
  ythickness = 4
  bg[NORMAL]   = "#181b2a"
  bg[PRELIGHT] = "#2e3552"
  bg[SELECTED] = "#3b6cc4"
  fg[NORMAL]   = "#e2e8f0"
  fg[PRELIGHT] = "#ffffff"
}
widget_class "*<GtkMenu>*" style "adwaita-menu"
widget_class "*<GtkMenuItem>*" style "adwaita-menu"
