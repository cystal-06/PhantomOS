#!/bin/sh
case "$1" in
    start)
        printf "Starting Desktop: "
        for i in 1 2 3 4 5; do
            if [ -e /tmp/.X11-unix/X0 ] || pgrep -x Xorg >/dev/null; then
                break
            fi
            sleep 1
        done
        DISPLAY=:0 /usr/bin/fbsetroot -gradient VerticalGradient -from "#0f172a" -to "#1e1b4b" 2>/dev/null || true
        DISPLAY=:0 /usr/bin/fluxbox &
        sleep 1
        DISPLAY=:0 /usr/bin/xterm -geometry 92x26+80+60 -title "PhantomOS Terminal" &
        echo "OK"
        ;;
    stop)
        printf "Stopping Desktop: "
        killall xterm 2>/dev/null
        killall fluxbox 2>/dev/null
        echo "OK"
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
