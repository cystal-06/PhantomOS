#!/bin/sh
# ==============================================================================
# Mounts optional browser.squashfs addon (/dev/vdb) onto /opt/firefox
# Skipped automatically in headless boot mode
# ==============================================================================

MOUNT_POINT="/opt/firefox"
ADDON_DEV="/dev/vdb"

is_headless() {
    grep -qw "headless" /proc/cmdline 2>/dev/null
}

case "$1" in
    start)
        if is_headless; then
            exit 0
        fi
        if [ -b "${ADDON_DEV}" ]; then
            mkdir -p "${MOUNT_POINT}"
            if ! grep -q " ${MOUNT_POINT} " /proc/mounts 2>/dev/null; then
                printf "Mounting Browser Addon (%s -> %s): " "${ADDON_DEV}" "${MOUNT_POINT}"
                if mount -t squashfs -o ro "${ADDON_DEV}" "${MOUNT_POINT}" 2>/dev/null; then
                    echo "OK"
                else
                    echo "SKIP"
                fi
            fi
        fi
        ;;
    stop)
        if grep -q " ${MOUNT_POINT} " /proc/mounts 2>/dev/null; then
            umount "${MOUNT_POINT}" 2>/dev/null || true
        fi
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
